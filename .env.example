# QuickBill Environment Configuration
# Copy this to .env.local to connect to your Supabase instance

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional legacy JWT anon key fallback
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side / backend only (DO NOT prefix with EXPO_PUBLIC_ or commit real keys)
# SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json